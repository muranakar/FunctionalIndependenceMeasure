# fastlane 設定
# 認証情報は fastlane/.env で渡す（git管理外）

default_platform(:ios)

XCODEPROJ = "FunctionalIndependenceMeasure.xcodeproj"
SCHEME = "FunctionalIndependenceMeasure"
TEAM_ID = "DJ7VR35KC8"

platform :ios do
  desc "ビルドして TestFlight にアップロードする"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
      key_content: File.read(ENV['API_KEY_P8_FILE'])
    )

    # App Store Connect 上の最新ビルド番号の次を使う。
    # ローカルの番号から数えると、既にアップロード済みの番号と衝突して弾かれる
    latest = latest_testflight_build_number(
      api_key: api_key,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: latest + 1
    )
    UI.message("ビルド番号: #{latest + 1}")

    # SPM 構成のため xcodeproj を直接指定する（CocoaPods の workspace は廃止済み）
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      destination: "generic/platform=iOS",
      output_directory: "./build",
      output_name: "#{SCHEME}.ipa",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{ENV['API_KEY_P8_FILE']} " \
              "-authenticationKeyID #{ENV['APP_STORE_CONNECT_API_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_ISSUER_ID']}",
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID
      }
    )

    # バイナリのみアップロードする。審査提出はここでは行わない
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success("TestFlight へのアップロードが完了しました")
  end

  desc "テストを実行する"
  lane :test do
    run_tests(
      project: XCODEPROJ,
      scheme: SCHEME,
      destination: "platform=iOS Simulator,name=iPhone 16 Pro"
    )
  end
end
